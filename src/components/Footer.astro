---
const today = new Date();
---

<footer class="py-10">
  <div class="max-w-7xl xl:px-16 lg:px-8 px-4 mx-auto">
    <div class="flex flex-col gap-6 sm:gap-12">
      <div class="py-12 grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 lg:grid-cols-12 gap-x-8 gap-y-10 px-6 xl:px-0">
        <!-- Brand -->
        <div class="col-span-full lg:col-span-4">
          <div class="flex flex-col gap-6">
            <a href="/" class="flex items-center gap-2 text-lg font-semibold text-foreground">
              <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="32" height="32" rx="8" class="fill-foreground"/>
                <path d="M8 16L16 8L24 16L16 24L8 16Z" class="fill-background"/>
              </svg>
              <span>brief.tr</span>
            </a>

            <p class="text-base font-normal text-muted-foreground">
              Yapay zeka iş dünyasını dönüştürüyor. Şirketinizin AI devriminin parçası olması için uzman ekibimizle hizmetinizdeyiz.
            </p>

            <!-- Social Links -->
            <div class="flex items-center gap-4">
              <a href="#" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Twitter">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/>
                </svg>
              </a>
              <a href="#" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="LinkedIn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="currentColor"/>
                </svg>
              </a>
              <a href="#" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.162c3.204 0 3.584.012 4.849.07 1.17.054 1.805.249 2.228.413.56.218.96.478 1.38.898s.68.82.898 1.38c.164.423.36 1.058.413 2.228.058 1.265.07 1.645.07 4.849s-.012 3.584-.07 4.849c-.053 1.17-.249 1.805-.413 2.228a3.7 3.7 0 0 1-.898 1.38c-.42.42-.82.68-1.38.898-.423.164-1.058.36-2.228.413-1.265.058-1.645.07-4.849.07s-3.584-.012-4.849-.07c-1.17-.053-1.805-.249-2.228-.413a3.7 3.7 0 0 1-1.38-.898c-.42-.42-.68-.82-.898-1.38-.164-.423-.36-1.058-.413-2.228-.058-1.265-.07-1.645.07-4.849s.012-3.584.07-4.849c.054-1.17.249-1.805.413-2.228.218-.56.478-.96.898-1.38s.82-.68 1.38-.898c.423-.164 1.058-.36 2.228-.413 1.265-.058 1.645-.07 4.849-.07M12 0C8.741 0 8.332.014 7.052.072 5.775.131 4.902.333 4.14.63a5.9 5.9 0 0 0-2.126 1.384A5.9 5.9 0 0 0 .63 4.14c-.297.763-.5 1.635-.558 2.912C.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.059 1.277.261 2.15.558 2.912.307.79.717 1.459 1.384 2.126A5.9 5.9 0 0 0 4.14 23.37c.763.297 1.635.5 2.912.558C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.277-.059 2.15-.261 2.912-.558a5.9 5.9 0 0 0 2.126-1.384 5.9 5.9 0 0 0 1.384-2.126c.297-.763.5-1.635.558-2.912.058-1.28.072-1.689.072-4.948s-.014-3.668-.072-4.948c-.059-1.277-.261-2.15-.558-2.912a5.9 5.9 0 0 0-1.384-2.126A5.9 5.9 0 0 0 19.86.63c-.763-.297-1.635-.5-2.912-.558C15.668.014 15.259 0 12 0m0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m7.846-10.406a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0" fill="currentColor"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Spacer -->
        <div class="col-span-1 lg:block hidden"></div>

        <!-- Sitemap -->
        <div class="col-span-2">
          <div class="flex flex-col gap-4">
            <p class="text-base font-medium text-foreground">Harita</p>
            <ul class="flex flex-col gap-3 list-none m-0 p-0">
              <li><a href="/iletisim" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">İletişim</a></li>
              <li><a href="/#about" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Hakkımızda</a></li>
              <li><a href="/#projects" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Projeler</a></li>
              <li><a href="#" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Hizmetler</a></li>
              <li><a href="/abonelik" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Fiyatlandırma</a></li>
            </ul>
          </div>
        </div>

        <!-- Diğer Sayfalar -->
        <div class="col-span-2">
          <div class="flex flex-col gap-4">
            <p class="text-base font-medium text-foreground">Sayfalar</p>
            <ul class="flex flex-col gap-3 list-none m-0 p-0">
              <li><a href="/blog" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Blog</a></li>
              <li><a href="#" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Gizlilik Politikası</a></li>
              <li><a href="#" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Kullanım Koşulları</a></li>
            </ul>
          </div>
        </div>

        <!-- İletişim Detayları -->
        <div class="col-span-3">
          <div class="flex flex-col gap-4">
            <p class="text-base font-medium text-foreground">İletişim</p>
            <ul class="flex flex-col gap-3 list-none m-0 p-0">
              <li>
                <p class="text-base font-normal text-muted-foreground">
                  İstanbul, Türkiye
                </p>
              </li>
              <li>
                <a href="mailto:info@brief.tr" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">
                  info@brief.tr
                </a>
              </li>
              <li>
                <a href="/iletisim" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">
                  İletişim Formu
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="h-px bg-border"></div>

      <!-- Copyright -->
      <p class="text-sm font-normal text-muted-foreground text-center">
        © {today.getFullYear()} brief.tr. Tüm hakları saklıdır.
      </p>
    </div>
  </div>
</footer>
