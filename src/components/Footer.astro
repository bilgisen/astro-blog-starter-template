---
const today = new Date();
---

<footer class="py-6">
  <div class="max-w-7xl xl:px-16 lg:px-8 px-4 mx-auto">
    <div class="flex flex-col gap-6">
      <!-- Main Row -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 px-6 xl:px-0">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 text-lg font-semibold text-foreground">
          <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="8" class="fill-foreground"/>
            <path d="M8 16L16 8L24 16L16 24L8 16Z" class="fill-background"/>
          </svg>
          <span>brief.tr</span>
        </a>

        <!-- Navigation Links -->
        <nav class="flex items-center gap-8">
          <a href="/" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Ana Sayfa</a>
          <a href="#" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Hizmetler</a>
          <a href="/#projects" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Projeler</a>
          <a href="/#about" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Hakkımızda</a>
          <a href="/blog" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">Blog</a>
          <a href="/iletisim" class="text-base font-normal text-muted-foreground hover:text-foreground transition-colors">İletişim</a>
        </nav>
      </div>

      <!-- Divider -->
      <div class="h-px bg-border"></div>
    </div>
  </div>
</footer>
