---
const brands = [
  { name: "Brand 1", logo: "https://images.shadcnspace.com/assets/brand-logo/logoipsum-1.svg" },
  { name: "Brand 2", logo: "https://images.shadcnspace.com/assets/brand-logo/logoipsum-2.svg" },
  { name: "Brand 3", logo: "https://images.shadcnspace.com/assets/brand-logo/logoipsum-3.svg" },
  { name: "Brand 4", logo: "https://images.shadcnspace.com/assets/brand-logo/logoipsum-4.svg" },
  { name: "Brand 5", logo: "https://images.shadcnspace.com/assets/brand-logo/logoipsum-5.svg" },
];
---

<section class="py-6 md:py-10">
  <div class="container mx-auto max-w-6xl">
    <div class="flex flex-col gap-3">
      <!-- Label -->
      <div class="flex justify-center text-center py-3 md:py-4 relative">
        <div class="flex items-center justify-center gap-4">
          <div class="hidden md:block h-0.5 w-40 bg-gradient-to-l from-muted-foreground to-white dark:from-muted-foreground dark:to-transparent opacity-20"></div>
          <p class="text-sm font-normal sm:px-2 px-10 text-muted-foreground text-center">
            Loved by 1000+ big and small brands around the world
          </p>
          <div class="hidden md:block h-0.5 w-40 bg-gradient-to-r from-muted-foreground to-white dark:from-muted-foreground dark:to-transparent opacity-20"></div>
        </div>
      </div>

      <!-- Marquee -->
      <div class="py-4 overflow-hidden">
        <div class="flex animate-marquee [--duration:20s]">
          {[...brands, ...brands, ...brands].map((brand) => (
            <div class="flex-shrink-0 mr-6 lg:mr-20">
              <img
                src={brand.logo}
                alt={brand.name}
                class="w-36 h-8 dark:hidden"
              />
              <img
                src={brand.logo}
                alt={brand.name}
                class="hidden dark:block w-36 h-8"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
