---
export interface Props {
  title?: string;
  highlight?: string;
  description?: string;
  primaryCTA?: string;
}

const {
  title = "Building bold brands with",
  highlight = "thoughtful design",
  description = "At shadcn space, we help small startups tackle the world's biggest challenges with tailored solutions, guiding you from strategy to success in a competitive market.",
  primaryCTA = "Get Started",
} = Astro.props;

const avatars = [
  "https://i.pravatar.cc/150?img=11",
  "https://i.pravatar.cc/150?img=12",
  "https://i.pravatar.cc/150?img=13",
  "https://i.pravatar.cc/150?img=14",
];
---

<section class="w-full h-full relative">
  <!-- Gradient blob background - birebir kaynak -->
  <div class="relative w-full pt-0 md:pt-20 pb-6 md:pb-10">
    <div class="absolute w-full h-full bg-gradient-to-r from-sky-100 via-white to-amber-100 rounded-full top-24 blur-3xl -z-10 dark:from-slate-800 dark:via-black dark:to-stone-700"></div>

    <div class="container mx-auto relative z-10">
      <div class="flex flex-col max-w-5xl mx-auto gap-8">
        <!-- Text Content -->
        <div class="relative flex flex-col text-center items-center gap-4 sm:gap-6">
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-medium leading-[1.4] md:leading-[1.6] lg:leading-[1.7] animate-fade-in">
            {title}{" "}
            <span class="font-serif italic tracking-tight">
              {highlight}
            </span>
          </h1>
          <p class="text-base font-normal max-w-2xl text-muted-foreground animate-fade-in-delay">
            {description}
          </p>
        </div>

        <!-- CTA + Social Proof -->
        <div class="flex items-center flex-col md:flex-row justify-center gap-8 animate-fade-in-delay-2">
          <!-- Button -->
          <a
            href="#"
            class="group relative inline-flex items-center justify-center h-12 p-1 pl-6 pr-14 text-sm font-medium rounded-full bg-primary text-primary-foreground transition-all duration-500 hover:pl-14 hover:pr-6 w-fit overflow-hidden"
          >
            <span class="relative z-10 transition-all duration-500">
              {primaryCTA}
            </span>
            <div class="absolute right-1 w-10 h-10 bg-background text-foreground rounded-full flex items-center justify-center transition-all duration-500 group-hover:right-[calc(100%-44px)] group-hover:rotate-45">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
              </svg>
            </div>
          </a>

          <!-- Social Proof -->
          <div class="flex items-center gap-3 sm:gap-7">
            <!-- Avatar Stack -->
            <ul class="flex flex-row items-center">
              {avatars.map((avatar, index) => (
                <li class:list={[
                  "-mr-2 transition-all duration-300",
                  index === 0 && "z-40",
                  index === 1 && "z-30",
                  index === 2 && "z-20",
                  index === 3 && "z-10",
                  "hover:ml-2",
                ]}>
                  <img
                    src={avatar}
                    alt="Avatar"
                    width={40}
                    height={40}
                    class="rounded-full border-2 border-white"
                  />
                </li>
              ))}
            </ul>

            <!-- Rating -->
            <div class="flex flex-col items-start gap-1">
              <div class="flex gap-1">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg class="h-4 w-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="sm:text-sm text-xs font-normal text-muted-foreground">
                Trusted by 1000+ clients
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-in-out forwards;
  }

  .animate-fade-in-delay {
    animation: fadeIn 1s ease-in-out 0.1s forwards;
    opacity: 0;
  }

  .animate-fade-in-delay-2 {
    animation: fadeIn 1s ease-in-out 0.2s forwards;
    opacity: 0;
  }
</style>
