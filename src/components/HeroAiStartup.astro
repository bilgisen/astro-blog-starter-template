---
export interface Props {
  title?: string;
  highlight?: string;
  description?: string;
  primaryCTA?: string;
}

const {
  title = "Yapay zeka çağına",
  highlight = "hazır mısınız?",
  description = "Web sitenizin yapay zeka iş dünyasını dönüştürüyor. Şirketinizin AI devriminin parçası olması için uzman ekibimizle hizmetinizdeyiz.",
  primaryCTA = "Sizi Arayalım",
} = Astro.props;
---

<section class="w-full h-full relative">
  <!-- Gradient blob background -->
  <div class="relative w-full pt-0 md:pt-20 pb-6 md:pb-10">
    <div class="absolute w-full h-full bg-gradient-to-r from-sky-100 via-white to-amber-100 rounded-full top-24 blur-3xl -z-10 dark:from-slate-800 dark:via-black dark:to-stone-700"></div>

    <div class="container mx-auto relative z-10">
      <div class="flex flex-col max-w-5xl mx-auto gap-8">
        <!-- Text Content -->
        <div class="relative flex flex-col text-center items-center gap-4 sm:gap-6">
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-medium leading-[1.4] md:leading-[1.6] lg:leading-[1.7] animate-fade-in">
            {title}{" "}
            <span class="font-serif italic tracking-tight">
              {highlight}
            </span>
          </h1>
          <p class="text-base font-normal max-w-2xl text-muted-foreground animate-fade-in-delay">
            {description}
          </p>
        </div>

        <!-- CTA -->
        <div class="flex justify-center animate-fade-in-delay-2">
          <a
            href="/iletisim"
            class="group relative inline-flex items-center justify-center h-12 p-1 pl-6 pr-14 text-sm font-medium rounded-full bg-primary text-primary-foreground transition-all duration-500 hover:pl-14 hover:pr-6 w-fit overflow-hidden"
          >
            <span class="relative z-10 transition-all duration-500">
              {primaryCTA}
            </span>
            <div class="absolute right-1 w-10 h-10 bg-background text-foreground rounded-full flex items-center justify-center transition-all duration-500 group-hover:right-[calc(100%-44px)] group-hover:rotate-45">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 1s ease-in-out forwards;
  }

  .animate-fade-in-delay {
    animation: fadeIn 1s ease-in-out 0.1s forwards;
    opacity: 0;
  }

  .animate-fade-in-delay-2 {
    animation: fadeIn 1s ease-in-out 0.2s forwards;
    opacity: 0;
  }
</style>
