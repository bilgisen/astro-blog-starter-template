---
export interface Props {
  title?: string;
  highlight?: string;
  description?: string;
  primaryCTA?: string;
  secondaryCTA?: string;
  stats?: { value: string; label: string }[];
}

const {
  title = "Building bold brands with",
  highlight = "thoughtful design",
  description = "We help small startups tackle the world's biggest challenges with tailored solutions, guiding you from strategy to success in a competitive market.",
  primaryCTA = "Get Started",
  secondaryCTA = "View Our Work",
  stats = [
    { value: "500+", label: "Projects Delivered" },
    { value: "98%", label: "Client Satisfaction" },
    { value: "50+", label: "Team Members" },
  ]
} = Astro.props;

const avatars = [
  "https://i.pravatar.cc/150?img=1",
  "https://i.pravatar.cc/150?img=2",
  "https://i.pravatar.cc/150?img=3",
  "https://i.pravatar.cc/150?img=4",
  "https://i.pravatar.cc/150?img=5",
];

const brands = ["Vercel", "Stripe", "Linear", "Notion", "Figma", "Raycast"];
---

<section class="relative w-full overflow-hidden">
  <!-- Subtle gradient background -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-br from-sky-50 via-white to-amber-50 dark:from-slate-900 dark:via-black dark:to-stone-900"></div>
    <div class="absolute top-24 left-1/2 -translate-x-1/2 w-full h-full max-w-4xl bg-gradient-to-r from-sky-100 via-white to-amber-100 dark:from-slate-800 dark:via-black dark:to-stone-700 rounded-full blur-3xl opacity-60"></div>
  </div>

  <div class="container mx-auto px-4 pt-20 pb-10 md:pt-32 md:pb-16">
    <div class="flex flex-col max-w-5xl mx-auto gap-10">
      <!-- Main Content -->
      <div class="relative flex flex-col text-center items-center gap-6">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-border bg-background/60 backdrop-blur-sm text-sm text-muted-foreground">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Now in Public Beta
        </div>

        <!-- Headline -->
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-medium leading-[1.1] md:leading-[1.15] lg:leading-[1.2] tracking-tight">
          {title}{" "}
          <span class="font-serif italic tracking-tight text-foreground">
            {highlight}
          </span>
        </h1>

        <!-- Description -->
        <p class="text-base md:text-lg font-normal max-w-2xl text-muted-foreground leading-relaxed">
          {description}
        </p>
      </div>

      <!-- CTA Section -->
      <div class="flex items-center flex-col md:flex-row justify-center gap-8">
        <!-- Primary CTA Button -->
        <a
          href="#"
          class="group relative inline-flex items-center justify-center h-12 pl-6 pr-14 text-sm font-medium rounded-full bg-primary text-primary-foreground overflow-hidden transition-all duration-500 hover:pl-14 hover:pr-6 w-fit"
        >
          <span class="relative z-10 transition-all duration-500">
            {primaryCTA}
          </span>
          <div class="absolute right-1 w-10 h-10 bg-background text-foreground rounded-full flex items-center justify-center transition-all duration-500 group-hover:right-[calc(100%-44px)] group-hover:rotate-45">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </div>
        </a>

        <!-- Social Proof -->
        <div class="flex items-center gap-4">
          <!-- Avatar Stack -->
          <ul class="flex items-center">
            {avatars.map((avatar, index) => (
              <li class:list={[
                "-mr-2 z-10 transition-all duration-300 hover:ml-2",
                index === 0 && "z-50",
                index === 1 && "z-40",
                index === 2 && "z-30",
                index === 3 && "z-20",
              ]}>
                <img
                  src={avatar}
                  alt="Team member"
                  width={40}
                  height={40}
                  class="rounded-full border-2 border-white dark:border-slate-900"
                />
              </li>
            ))}
          </ul>

          <!-- Rating -->
          <div class="flex flex-col items-start gap-1">
            <div class="flex gap-0.5">
              {[1, 2, 3, 4, 5].map(() => (
                <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-xs font-normal text-muted-foreground">
              Trusted by 1000+ clients
            </p>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-8 max-w-lg mx-auto pt-8 border-t border-border/50">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-2xl md:text-3xl font-semibold text-foreground">{stat.value}</div>
            <div class="text-xs md:text-sm text-muted-foreground mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Brand Slider -->
  <div class="py-8 md:py-12 border-t border-border/50">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="flex flex-col gap-6">
        <!-- Label -->
        <div class="flex justify-center items-center gap-4">
          <div class="hidden md:block h-px w-32 bg-gradient-to-l from-muted-foreground to-transparent opacity-20"></div>
          <p class="text-sm font-normal text-muted-foreground text-center px-4">
            Loved by 1000+ big and small brands around the world
          </p>
          <div class="hidden md:block h-px w-32 bg-gradient-to-r from-muted-foreground to-transparent opacity-20"></div>
        </div>

        <!-- Marquee -->
        <div class="overflow-hidden">
          <div class="flex animate-marquee [--duration:20s]">
            {[...brands, ...brands, ...brands].map((brand) => (
              <div class="flex-shrink-0 px-8 md:px-16">
                <span class="text-lg md:text-xl font-semibold text-muted-foreground/40 hover:text-muted-foreground/60 transition-colors duration-300">
                  {brand}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
