---
import { SITE_TITLE } from '../consts';

const navItems = [
  { title: "Home", href: "/" },
  { title: "Blog", href: "/blog" },
  { title: "About", href: "/about" },
];
---

<header class="inset-x-0 z-50 px-4 flex items-center justify-center sticky top-0 h-20">
  <div class="nav-container w-full max-w-6xl flex items-center h-fit justify-between gap-3.5 lg:gap-6 transition-all duration-500 bg-transparent border-transparent">
    <!-- Logo -->
    <div>
      <a href="/" class="flex items-center gap-2 text-lg font-semibold text-foreground">
        <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" class="fill-foreground"/>
          <path d="M8 16L16 8L24 16L16 24L8 16Z" class="fill-background"/>
        </svg>
        <span>{SITE_TITLE}</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="max-lg:hidden bg-muted p-0.5 rounded-full">
      <ul class="flex gap-0 list-none m-0 p-0">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "px-4 py-2 text-sm font-medium rounded-full transition-all duration-200",
                Astro.url.pathname === item.href
                  ? "text-foreground bg-background shadow-sm"
                  : "text-muted-foreground hover:text-foreground hover:bg-background/50",
              ]}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- CTA -->
    <div class="flex gap-4">
      <a
        href="#"
        class="group relative hidden sm:inline-flex items-center justify-center h-10 pl-4 pr-12 text-sm font-medium rounded-full bg-primary text-primary-foreground overflow-hidden transition-all duration-500 hover:pl-12 hover:pr-4 w-fit"
      >
        <span class="relative z-10 transition-all duration-500">
          Let's Collaborate
        </span>
        <div class="absolute right-1 w-8 h-8 bg-background text-foreground rounded-full flex items-center justify-center transition-all duration-500 group-hover:right-[calc(100%-36px)] group-hover:rotate-45">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </div>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden rounded-full border border-border p-2 hover:bg-muted transition-colors"
        aria-label="Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 bg-background/95 backdrop-blur-lg hidden lg:hidden"
  >
    <div class="flex items-center justify-between p-6">
      <a href="/" class="flex items-center gap-2 text-lg font-semibold text-foreground">
        <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" class="fill-foreground"/>
          <path d="M8 16L16 8L24 16L16 24L8 16Z" class="fill-background"/>
        </svg>
        <span>{SITE_TITLE}</span>
      </a>
      <button
        id="mobile-menu-close"
        class="rounded-full border border-border p-2.5 hover:bg-muted transition-colors"
        aria-label="Close"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-8 px-6 pb-6">
      <ul class="flex flex-col items-start gap-6 list-none m-0 p-0">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-2xl font-semibold tracking-tight transition-all hover:translate-x-2 p-0"
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="w-fit">
        <a
          href="#"
          class="group relative inline-flex items-center justify-center h-10 pl-4 pr-12 text-sm font-medium rounded-full bg-primary text-primary-foreground overflow-hidden transition-all duration-500 hover:pl-12 hover:pr-4 w-fit"
        >
          <span class="relative z-10 transition-all duration-500">
            Let's Collaborate
          </span>
          <div class="absolute right-1 w-8 h-8 bg-background text-foreground rounded-full flex items-center justify-center transition-all duration-500 group-hover:right-[calc(100%-36px)] group-hover:rotate-45">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </div>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuClose = document.getElementById('mobile-menu-close');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
  });

  mobileMenuClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
  });

  // Sticky header
  const header = document.querySelector('header');
  const navContainer = document.querySelector('.nav-container');

  window.addEventListener('scroll', () => {
    if (window.scrollY >= 50) {
      navContainer?.classList.add(
        'p-2.5', 'bg-background/60', 'backdrop-blur-lg', 'border', 'border-border/40', 'shadow-2xl', 'shadow-primary/5', 'rounded-full'
      );
      navContainer?.classList.remove('bg-transparent', 'border-transparent');
    } else {
      navContainer?.classList.remove(
        'p-2.5', 'bg-background/60', 'backdrop-blur-lg', 'border', 'border-border/40', 'shadow-2xl', 'shadow-primary/5', 'rounded-full'
      );
      navContainer?.classList.add('bg-transparent', 'border-transparent');
    }
  });
</script>
