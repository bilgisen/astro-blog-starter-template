---
import BaseHead from '../../components/BaseHead.astro';
import BlogNavbar from '../../components/BlogNavbar.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-background">
		<BlogNavbar />
		<main class="container mx-auto px-4 py-16 md:py-24">
			<div class="max-w-5xl mx-auto">
				<!-- Header -->
				<div class="text-center mb-16">
					<h1 class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight mb-6">
						<span class="font-serif italic">Blog</span>
					</h1>
					<p class="text-lg text-muted-foreground max-w-2xl mx-auto">
						Yapay zeka ve dijital dönüşüm hakkındaki en son yazılarımız
					</p>
				</div>

				<!-- Posts Grid -->
				<div class="grid md:grid-cols-2 gap-8">
					{
						posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="group block rounded-2xl border border-border bg-card overflow-hidden hover:shadow-lg transition-shadow duration-300">
								{post.data.heroImage && (
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-48 object-cover"
									/>
								)}
								<div class="p-6">
									<h2 class="text-xl font-semibold mb-2 group-hover:text-primary transition-colors">
										{post.data.title}
									</h2>
									<p class="text-sm text-muted-foreground">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
