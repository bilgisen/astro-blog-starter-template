---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={`İletişim | ${SITE_TITLE}`} description="Bizimle iletişime geçin" />
  </head>
  <body class="min-h-screen bg-background">
    <Navbar />
    <main class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight mb-6">
            <span class="font-serif italic">İletişime</span> geçin
          </h1>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Projeniz hakkında konuşmak veya fiyat teklifi almak için bize ulaşın.
            Uzman ekibimiz en kısa sürede size geri dönecektir.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-12">
          <!-- Contact Form -->
          <div class="space-y-6">
            <form class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium mb-2">Adınız</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
                  placeholder="Adınız Soyadınız"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium mb-2">E-posta</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
                  placeholder="ornek@email.com"
                />
              </div>
              <div>
                <label for="company" class="block text-sm font-medium mb-2">Şirket</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
                  placeholder="Şirket adı (opsiyonel)"
                />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium mb-2">Mesajınız</label>
                <textarea
                  id="message"
                  name="message"
                  rows={5}
                  class="w-full px-4 py-3 rounded-lg border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors resize-none"
                  placeholder="Projeniz hakkında detay paylaşın..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full group relative inline-flex items-center justify-center h-12 p-1 pl-6 pr-14 text-sm font-medium rounded-full bg-primary text-primary-foreground transition-all duration-500 hover:pl-14 hover:pr-6 overflow-hidden"
              >
                <span class="relative z-10 transition-all duration-500">
                  Gönder
                </span>
                <div class="absolute right-1 w-10 h-10 bg-background text-foreground rounded-full flex items-center justify-center transition-all duration-500 group-hover:right-[calc(100%-44px)] group-hover:rotate-45">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
                  </svg>
                </div>
              </button>
            </form>
          </div>

          <!-- Contact Info -->
          <div class="space-y-8">
            <div class="p-6 rounded-2xl border border-border bg-card">
              <h3 class="text-lg font-semibold mb-4">Adres</h3>
              <p class="text-muted-foreground">
                İstanbul, Türkiye
              </p>
            </div>
            <div class="p-6 rounded-2xl border border-border bg-card">
              <h3 class="text-lg font-semibold mb-4">E-posta</h3>
              <a href="mailto:merhaba@brief.tr" class="text-muted-foreground hover:text-foreground transition-colors">
                merhaba@brief.tr
              </a>
            </div>
            <div class="p-6 rounded-2xl border border-border bg-card">
              <h3 class="text-lg font-semibold mb-4">Çalışma Saatleri</h3>
              <p class="text-muted-foreground">
                Pazartesi - Cuma: 09:00 - 18:00
              </p>
            </div>
            <div class="p-6 rounded-2xl border border-border bg-card">
              <h3 class="text-lg font-semibold mb-4">Sosyal Medya</h3>
              <div class="flex gap-3">
                <a href="#" class="p-2.5 rounded-full border border-border hover:bg-muted transition-colors" aria-label="Twitter">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <a href="#" class="p-2.5 rounded-full border border-border hover:bg-muted transition-colors" aria-label="LinkedIn">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
